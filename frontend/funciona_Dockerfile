#------------- DockerFile Angular -------------

# Etapa 1: Entorno Node-18 para construir la aplicación Angular
FROM node:18-alpine AS build

# Directorio de trabajo
WORKDIR /app

# Copiar los packages
COPY package*.json ./

# Instalar dependencias
RUN npm ci
RUN npm install -g nodemon
RUN npm install

# Copiar el resto del código de Angular
COPY ./ ./

# Compilar la aplicación
RUN npm run build

#--------------------- Etapa 2 ----------------------------
# Entorno NGINX para servir la aplicación
FROM nginx:alpine

# Copiar los archivos compilados de Angular
COPY --from=build /app/dist/prime-checker/browser /usr/share/nginx/html

# Exponer el puerto de escucha
EXPOSE 80

# Ejecutar NGINX
CMD ["nginx", "-g", "daemon off;"]
